# --- Database (Neon via Vercel Marketplace injects these) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"   # pooled
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"     # direct, for migrations

# --- Auth (Clerk via Vercel Marketplace injects these) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Uploads (Vercel Blob store injects this) ---
BLOB_READ_WRITE_TOKEN=""

# --- Video providers (any subset; users can also bring their own key) ---
WAVESPEED_API_KEY=""          # https://wavespeed.ai  (default provider)
MUAPI_API_KEY=""              # https://muapi.ai
HF_TOKEN=""                   # https://huggingface.co/settings/tokens (free "read" token; raises ZeroGPU quota)

# MUAPI completion webhook. WEBHOOK_URL defaults to the Vercel production URL.
MUAPI_WEBHOOK_SECRET=""       # openssl rand -hex 16
WEBHOOK_URL=""

# --- Stripe (optional; app runs without it) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- UI ---
NEXT_PUBLIC_THEME="slate-indigo"   # slate-indigo | cyberpunk | emerald | sunset | midnight

# --- Operations (personas / scheduling) ---
ANTHROPIC_API_KEY=""          # console.anthropic.com — writes ideas, scripts, captions, identity QA
CLAUDE_MODEL="claude-opus-5"  # or claude-sonnet-5 to cut cost
TOKEN_ENCRYPTION_KEY=""       # openssl rand -base64 32 — encrypts OAuth tokens and stored keys
OWNER_EMAIL=""                # this login gets the owner role (platform settings, manual triggers)
OPS_SECRET=""                 # bearer token for /api/ops/* from scripts
NEXT_PUBLIC_APP_URL="http://localhost:3000"
YOUTUBE_API_KEY=""            # Google Cloud API key (free) for competitor benchmarks on YouTube
X_BEARER_TOKEN=""             # X app bearer token for competitor reads (pay-per-use)

# --- Platform developer apps (optional; the /settings/platforms page can hold these instead) ---
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
