generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// One row per signed-in person. `id` is the Clerk user id.
model User {
  id            String    @id
  name          String?
  email         String?   @unique
  image         String?
  credits       Int       @default(100)
  /// Per-provider API keys the user brings themselves, e.g. { "wavespeed": "...", "muapi": "..." }
  apiKeys       Json?
  creations     Creation[]
  actors        Actor[]
}

/// A saved, reusable AI actor (reference face) owned by a user.
model Actor {
  id          String   @id @default(cuid())
  userId      String
  name        String
  imageUrl    String   @db.Text
  gender      String?
  ageRange    String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creations Creation[]

  @@index([userId])
}

model Creation {
  id        String   @id @default(cuid())
  type      String?  // video or image
  title     String?
  prompt    String?  @db.Text
  url       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  /// Which adapter produced this: wavespeed | muapi | zerogpu
  provider  String   @default("wavespeed")
  requestId String?
  /// "server" when Chris's key paid for it, "user" when the user's own key did
  keySource String   @default("server")
  status    String   @default("processing")
  error     String?  @db.Text

  // Generation parameters
  modelId     String?
  aspectRatio String?
  resolution  String?
  duration    Int?
  mode        String?
  inputImages String[] @default([])
  /// Provider-specific scratch data (audio URL, pipeline step, etc.)
  meta        Json?

  actorId String?
  actor   Actor?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, requestId])
  @@index([userId, createdAt])
}
