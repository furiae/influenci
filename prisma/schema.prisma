generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// One row per signed-in person. `id` is the Clerk user id.
model User {
  id        String     @id
  name      String?
  email     String?    @unique
  image     String?
  credits   Int        @default(100)
  /// "owner" unlocks platform settings and manual scheduler triggers
  role      String     @default("member")
  /// Per-provider API keys the user brings themselves (values encrypted), e.g. { "wavespeed": "v1...." }
  apiKeys   Json?
  creations Creation[]
  actors    Actor[]
  posts     Post[]
}

/// A recurring AI persona: reference look, bible, cadence, connected channels.
model Actor {
  id       String  @id @default(cuid())
  userId   String
  name     String
  slug     String?
  kind     String  @default("human") // human | pet
  active   Boolean @default(true)
  imageUrl String  @db.Text // canonical frontal / hero image
  gender   String?
  ageRange String?
  notes    String? @db.Text
  timezone String  @default("America/New_York")

  // Persona
  bible           Json?
  canonicalPrompt String? @db.Text
  negativePrompt  String? @db.Text

  // Identity assets
  referenceImages String[] @default([])
  datasetZipUrl   String?  @db.Text
  loraUrl         String?  @db.Text
  loraTriggerWord String?
  klingElementId  String?
  identityStatus  String   @default("none") // none | generating_refs | training | ready | failed
  identityError   String?  @db.Text
  identityJobId   String?

  // Brand accounts (kind = "brand"): a real business profile we manage
  brandProfile        Json?
  designSystem        Json?
  designSystemVersion Int       @default(0)
  insightsSummary     Json?
  importStatus        String    @default("none") // none | importing | ready | failed
  importRunId         String?
  importError         String?   @db.Text
  lastImportAt        DateTime?

  // Scheduling
  autoPublish  Boolean @default(false)
  videosPerDay Int     @default(1)
  defaultClip  Json? // { lengthSec: 5|10, audio: true, mediaType: "video"|"image" }
  cadence      Json? // { window:{start,end}, minSpacingMinutes, platforms:{ tiktok:{perDay}, ... } }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creations       Creation[]
  channels        Channel[]
  posts           Post[]
  competitors     Competitor[]
  channelPosts    ChannelPost[]
  recommendations Recommendation[]

  @@unique([userId, slug])
  @@index([userId])
}

/// A reference account whose public posts are benchmarks for one actor.
model Competitor {
  id            String    @id @default(cuid())
  actorId       String
  platform      String // youtube | x | instagram | tiktok | pinterest | facebook
  handle        String
  externalId    String?
  displayName   String?
  url           String?   @db.Text
  followers     Int?
  active        Boolean   @default(true)
  notes         String?   @db.Text
  lastFetchedAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  actor Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  posts BenchmarkPost[]

  @@unique([actorId, platform, handle])
  @@index([actorId])
}

/// A public post fetched from a competitor, with engagement metrics.
model BenchmarkPost {
  id           String    @id @default(cuid())
  competitorId String
  platform     String
  externalId   String
  url          String?   @db.Text
  caption      String?   @db.Text
  mediaType    String?
  thumbnailUrl String?   @db.Text
  postedAt     DateTime?
  likes        Int       @default(0)
  comments     Int       @default(0)
  shares       Int       @default(0)
  views        Int       @default(0)
  score        Float     @default(0)
  durationSec  Int?
  /// Gemini video analysis: { hook, summary, structure, visualStyle, whyItWorks, onScreenText, cta, transcriptExcerpt }
  analysis     Json?
  analyzedAt   DateTime?
  fetchedAt    DateTime  @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, externalId])
  @@index([competitorId, score])
}

/// A connected social account for one actor on one platform.
model Channel {
  id               String    @id @default(cuid())
  actorId          String
  platform         String // instagram | facebook | tiktok | youtube | pinterest | x
  externalId       String
  handle           String?
  displayName      String?
  avatarUrl        String?   @db.Text
  accessTokenEnc   String    @db.Text
  refreshTokenEnc  String?   @db.Text
  tokenExpiresAt   DateTime?
  refreshExpiresAt DateTime?
  scopes           String[]  @default([])
  status           String    @default("connected") // connected | expiring | expired | revoked | error | disconnected
  lastError        String?   @db.Text
  lastCheckedAt    DateTime?
  lastPublishedAt  DateTime?
  config           Json?
  followers        Int?
  following        Int?
  mediaCount       Int?
  lastSyncedAt     DateTime?
  syncCursor       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  actor         Actor                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  targets       PostTarget[]
  channelPosts  ChannelPost[]
  dailyInsights ChannelDailyInsight[]

  @@unique([actorId, platform])
  @@index([platform, status])
}

/// One piece of content for an actor: idea → script → keyframe → clip or still.
model Post {
  id            String    @id @default(cuid())
  actorId       String
  userId        String
  planDate      String // "YYYY-MM-DD" in the actor's timezone
  sequence      Int       @default(0)
  mediaType     String    @default("video") // video | image
  clipLengthSec Int       @default(5)
  status        String    @default("planned") // planned | rendering | draft | approved | publishing | published | partial | failed | cancelled
  idea          String?   @db.Text
  pillar        String?
  hook          String?   @db.Text
  script        Json?
  keyframeUrl   String?   @db.Text
  keyframeQa    Json?
  creationId    String?   @unique
  videoUrl      String?   @db.Text
  videoMeta     Json?
  renderRunId   String?
  renderError   String?   @db.Text
  costCents     Int       @default(0)
  approvedAt    DateTime?
  approvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  actor          Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation       Creation?       @relation(fields: [creationId], references: [id], onDelete: SetNull)
  targets        PostTarget[]
  events         PipelineEvent[]
  recommendation Recommendation?

  @@unique([actorId, planDate, sequence])
  @@index([userId, planDate])
  @@index([status])
}

/// The per-platform variant of a Post and its publish result.
model PostTarget {
  id            String    @id @default(cuid())
  postId        String
  platform      String
  slotIndex     Int       @default(0)
  channelId     String?
  caption       String?   @db.Text
  title         String?
  hashtags      String[]  @default([])
  settings      Json?
  scheduledAt   DateTime
  status        String    @default("pending") // pending | queued | publishing | published | failed | skipped | cancelled
  attempts      Int       @default(0)
  lockedAt      DateTime?
  publishRunId  String?
  providerState Json?
  externalId    String?
  url           String?   @db.Text
  error         String?   @db.Text
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  channelPost ChannelPost?

  @@unique([postId, platform, slotIndex])
  @@index([status, scheduledAt])
  @@index([channelId, publishedAt])
}

/// Developer-app credentials per platform (meta serves instagram + facebook).
model PlatformApp {
  platform        String   @id // meta | tiktok | youtube | pinterest | x
  clientId        String
  clientSecretEnc String   @db.Text
  extra           Json?
  reviewStatus    Json?
  updatedAt       DateTime @updatedAt
}

/// Pipeline log and cost ledger.
model PipelineEvent {
  id        String   @id @default(cuid())
  postId    String?
  actorId   String?
  kind      String // render | publish | identity | plan | scheduler
  step      String
  status    String // ok | retry | failed
  message   String?  @db.Text
  costCents Int      @default(0)
  data      Json?
  createdAt DateTime @default(now())

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([actorId, createdAt])
}

/// A rendered asset (Ad Builder output or a Post's video).
model Creation {
  id        String   @id @default(cuid())
  type      String? // video or image
  title     String?
  prompt    String?  @db.Text
  url       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  /// Which adapter produced this: wavespeed | muapi | zerogpu
  provider  String  @default("wavespeed")
  requestId String?
  /// "server" when Chris's key paid for it, "user" when the user's own key did
  keySource String  @default("server")
  status    String  @default("processing")
  error     String? @db.Text

  // Generation parameters
  modelId     String?
  aspectRatio String?
  resolution  String?
  duration    Int?
  mode        String?
  inputImages String[] @default([])
  /// Provider-specific scratch data (audio URL, pipeline step, etc.)
  meta        Json?

  actorId String?
  actor   Actor?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  post    Post?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, requestId])
  @@index([userId, createdAt])
}

/// Small key/value store for scheduler state (ticker run id, last planner day…).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One of OUR OWN posts on a connected channel: imported history or something
/// Influenci published. Carries metrics, a 1-10 score and Claude's analysis.
model ChannelPost {
  id           String    @id @default(cuid())
  channelId    String?
  actorId      String
  platform     String
  externalId   String
  url          String?   @db.Text
  caption      String?   @db.Text
  mediaType    String? // image | video | carousel | reel | story | link | text
  mediaUrls    String[]  @default([])
  thumbnailUrl String?   @db.Text
  postedAt     DateTime?
  source       String    @default("import") // import | influenci | screenshot | manual
  postTargetId String?   @unique

  // Metrics (latest)
  likes            Int    @default(0)
  comments         Int    @default(0)
  shares           Int    @default(0)
  saves            Int    @default(0)
  views            Int    @default(0)
  reach            Int?
  impressions      Int?
  clicks           Int?
  videoAvgWatchSec Float?
  reactionsByType  Json?
  followersAtFetch Int?

  // Derived
  engagementRate Float?
  reachRate      Float?
  score          Int? // 1..10
  scoreBreakdown Json?
  scoreVersion   Int    @default(0)

  // Analysis (Claude vision)
  analysis   Json?
  analyzedAt DateTime?
  topics     String[]  @default([])
  format     String?
  hashtags   String[]  @default([])

  raw              Json?
  fetchedAt        DateTime  @default(now())
  metricsUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  channel    Channel?            @relation(fields: [channelId], references: [id], onDelete: SetNull)
  actor      Actor               @relation(fields: [actorId], references: [id], onDelete: Cascade)
  postTarget PostTarget?         @relation(fields: [postTargetId], references: [id], onDelete: SetNull)
  metrics    ChannelPostMetric[]

  @@unique([actorId, platform, externalId])
  @@index([actorId, postedAt])
  @@index([actorId, score])
}

/// Metric snapshot per sync, for velocity and growth charts.
model ChannelPostMetric {
  id            String   @id @default(cuid())
  channelPostId String
  capturedAt    DateTime @default(now())
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  views         Int      @default(0)
  reach         Int?

  channelPost ChannelPost @relation(fields: [channelPostId], references: [id], onDelete: Cascade)

  @@index([channelPostId, capturedAt])
}

/// Account-level daily insight row (followers, reach, profile views…).
model ChannelDailyInsight {
  id            String   @id @default(cuid())
  channelId     String
  date          String // "YYYY-MM-DD"
  followers     Int?
  newFollowers  Int?
  reach         Int?
  impressions   Int?
  profileViews  Int?
  websiteClicks Int?
  raw           Json?
  createdAt     DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
}

/// A recommended post for a brand, with a predicted score and the evidence.
model Recommendation {
  id                      String   @id @default(cuid())
  actorId                 String
  batchId                 String?
  status                  String   @default("suggested") // suggested | saved | dismissed | used
  kind                    String   @default("post") // post | campaign | repurpose
  platforms               String[] @default([])
  format                  String?
  title                   String
  concept                 String   @db.Text
  hook                    String?  @db.Text
  caption                 String?  @db.Text
  hashtags                String[] @default([])
  visualBrief             Json?
  bestTime                Json?
  predictedScore          Int?
  predictedReachLow       Int?
  predictedReachHigh      Int?
  predictedEngagementRate Float?
  confidence              Float?
  rationale               String?  @db.Text
  basedOn                 Json?
  postId                  String?  @unique
  actualScore             Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([actorId, status, createdAt])
}
